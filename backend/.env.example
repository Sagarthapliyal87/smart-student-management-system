# Copy this file to ".env" and fill in your own values. Never commit the real ".env".

# MySQL connection string. Default XAMPP: user "root", empty password.
DATABASE_URL="mysql://root:@localhost:3306/student_management_db"

# Any long random string, used to sign login tokens (JWT).
JWT_SECRET="replace_this_with_a_long_random_string"
JWT_EXPIRES_IN="7d"

PORT=5000
CLIENT_URL="http://localhost:5173"

# Optional: OpenAI API key for AI features. If blank, the app still works and
# the AI pages show a clear "AI not configured" message.
AI_API_KEY=
AI_MODEL="gpt-4o-mini"
